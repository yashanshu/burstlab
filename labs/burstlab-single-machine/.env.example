# Exact image tags were checked for the course on 2026-08-23. Revalidate them,
# and capture the locally resolved image digests, before publishing new results.
NATS_IMAGE=nats:2.14.5-alpine3.22
POSTGRES_IMAGE=postgres:18.6-bookworm

# Local synthetic-lab credentials. Do not reuse them outside this machine.
POSTGRES_DB=burstlab
POSTGRES_USER=burstlab
POSTGRES_PASSWORD=burstlab
DATABASE_URL=postgres://burstlab:burstlab@127.0.0.1:5432/burstlab?sslmode=disable
NATS_URL=nats://127.0.0.1:4222

# The API, worker, and load generator run natively. Keep the API on loopback.
HTTP_ADDR=127.0.0.1:8080
URL=http://127.0.0.1:8080
TOKEN=course-token
TOKEN_SHA256=83c73d47ada8f9b216cde8deac01905c1301da5f8ead6ded67bdf964f7468d6f

# Benchmark defaults. scripts/run-benchmark.sh accepts PROFILE and TARGET_RPS
# as its first two arguments, for example: discovery 1000
PROFILE=smoke
TARGET_RPS=100
HEALTH_DURATION=30s
DISCOVERY_DURATION=30s
LOW_DURATION=2m
RAMP_DURATION=3m
HOLD_DURATION=10m
PRE_ALLOCATED_VUS=100
MAX_VUS=1000
MAX_FAILURE_RATE=0.005
MAX_P95_MS=150
